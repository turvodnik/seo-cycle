#!/usr/bin/env python3
"""Launcher for the unified seo-cycle CLI (see scripts/seo_cycle_cli.py).

The global shim (~/.local/bin/seo-cycle) is a symlink into the shared vendor
store's HEAD. Run from inside an attached project, that would silently
execute the store's HEAD instead of the project's pinned version (D7). So
before running, this launcher looks upward from $PWD for
.agents/external/seo-cycle (the pinned worktree an attach created) and, if
found and different from this launcher's own root, re-execs that project's
own bin/seo-cycle instead. A guard env var prevents infinite recursion.

Secrets (T-108, policy §5): key values live in the macOS Keychain and reach
a process only through `ai-secret run <scope> -- <command>`. For commands
that fetch provider data (SECRET_COMMANDS) this launcher checks whether the
pulse keys are already in the environment; if not and `ai-secret` is on
PATH, it re-executes itself under `ai-secret run <scope>` (scope =
`project.brand_name_technical`), otherwise it prints ONE warning line to
stderr and continues — a run on stale data is never silent (I-061).
"""

import os
import pathlib
import sys

SKILL_ROOT = pathlib.Path(__file__).resolve().parent.parent


def _find_project_pin(start: pathlib.Path) -> pathlib.Path | None:
    cur = start
    while True:
        candidate = cur / ".agents" / "external" / "seo-cycle"
        if candidate.is_dir():
            return candidate.resolve()
        if cur.parent == cur:
            return None
        cur = cur.parent


def _maybe_redirect_to_project_pin() -> None:
    if os.environ.get("SEO_CYCLE_SHIM_REDIRECTED") == "1":
        return
    pinned = _find_project_pin(pathlib.Path.cwd())
    if pinned is None:
        print(
            "⚠ seo-cycle: версия хранилища, не пин проекта "
            "(нет .agents/external/seo-cycle выше по дереву)",
            file=sys.stderr,
        )
        return
    pinned_launcher = pinned / "bin" / "seo-cycle"
    if not pinned_launcher.is_file():
        return
    if pinned.resolve() == SKILL_ROOT.resolve():
        return
    env = dict(os.environ)
    env["SEO_CYCLE_SHIM_REDIRECTED"] = "1"
    os.execve(sys.executable, [sys.executable, str(pinned_launcher), *sys.argv[1:]], env)


_maybe_redirect_to_project_pin()

sys.path.insert(0, str(SKILL_ROOT / "scripts"))

from seo_cycle_cli import main  # noqa: E402

# Commands that call provider APIs and therefore need key values in the
# environment. Everything else (gates, reports, status, auth) runs as is.
SECRET_COMMANDS = frozenset({"pulse", "doctor", "sync", "ads", "feed", "cohorts", "notify"})


def _first_command(argv: list[str]) -> str | None:
    skip = False
    for arg in argv:
        if skip:
            skip = False
            continue
        if arg == "--project":
            skip = True
            continue
        if arg.startswith("-"):
            continue
        return arg
    return None


def _project_dir(argv: list[str]) -> pathlib.Path:
    for index, arg in enumerate(argv):
        if arg == "--project" and index + 1 < len(argv):
            return pathlib.Path(argv[index + 1]).expanduser()
        if arg.startswith("--project="):
            return pathlib.Path(arg.split("=", 1)[1]).expanduser()
    return pathlib.Path.cwd()


def _maybe_inject_secrets() -> None:
    """Re-exec under `ai-secret run <scope>` when a fetching command has no keys."""
    argv = sys.argv[1:]
    command = _first_command(argv)
    if command not in SECRET_COMMANDS:
        return
    # Imported here, not at module level: the launcher must stay runnable for
    # every other command with nothing but seo_cycle_cli next to it.
    from seo_cycle_core.config import find_config, load_yaml
    from seo_cycle_core.env_profile import PULSE_KEY_NAMES, SECRETS_MARKER, find_ai_secret, secret_scope

    if os.environ.get(SECRETS_MARKER) == "1":
        return
    if any(os.environ.get(name) for name in PULSE_KEY_NAMES):
        return  # keys already provided (manual `ai-secret run`, CI, export) — never override them
    cfg_path = find_config(_project_dir(argv))
    if cfg_path is None:
        return  # the command itself reports the missing config
    scope = secret_scope(load_yaml(cfg_path))
    binary = find_ai_secret()
    if binary is None:
        print(
            f"⚠ seo-cycle {command}: ключи провайдеров не в окружении и `ai-secret` не найден — "
            "свежих данных не будет, прогон пойдёт на прошлом срезе. Установи ai-secret или "
            "экспортируй переменные в окружение сессии.",
            file=sys.stderr,
        )
        return
    if scope is None:
        print(
            f"⚠ seo-cycle {command}: ключи провайдеров не в окружении, а scope Keychain не определён "
            f"(нет project.brand_name_technical в {cfg_path.name}) — запусти вручную: "
            f"ai-secret run <scope> -- seo-cycle {' '.join(argv)}",
            file=sys.stderr,
        )
        return
    env = dict(os.environ)
    env[SECRETS_MARKER] = "1"
    os.execve(binary, [binary, "run", scope, "--", sys.executable, str(pathlib.Path(__file__).resolve()), *argv], env)


_maybe_inject_secrets()

if __name__ == "__main__":
    raise SystemExit(main())
